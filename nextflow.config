params {
    samplesheet = null
    ref      = "data/ref/REL606.fa"
    gbk      = "data/ref/REL606.gbk"
    outdir   = "results_nf"
    min_qual = 30
    min_dp   = 10
    min_mq   = 40
}

process {
    cpus = 4
}

profiles {
    test {
        params.samplesheet = "tests/samplesheet.csv"
        params.ref    = "tests/data/ref/REL606.fa"
        params.gbk    = "tests/data/ref/REL606.gbk"
        params.outdir = "results_test"
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ecoli-varcall:0.2'
    }
}
